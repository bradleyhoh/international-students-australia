{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Small multiples: international enrolments by education sector, 2018–2025, each indexed to its own 2018 level (2018 = 100) and drawn on one shared scale so sectors can be compared directly.",
  "data": {
    "url": "data/sector_trend.csv",
    "format": {
      "parse": {
        "year": "number",
        "enrolments": "number"
      }
    }
  },
  "transform": [
    {
      "joinaggregate": [
        {
          "op": "argmin",
          "field": "year",
          "as": "first"
        }
      ],
      "groupby": [
        "sector"
      ]
    },
    {
      "calculate": "datum.enrolments / datum.first.enrolments * 100",
      "as": "index"
    }
  ],
  "facet": {
    "field": "sector",
    "type": "nominal",
    "title": null,
    "sort": [
      "Higher Education",
      "VET",
      "ELICOS",
      "Non-award",
      "Schools"
    ],
    "header": {
      "labelFontSize": 13,
      "labelFontWeight": 600,
      "labelAnchor": "start",
      "labelColor": "#1F2A37"
    }
  },
  "columns": 5,
  "spec": {
    "width": 150,
    "height": 130,
    "layer": [
      {
        "data": {
          "values": [
            {
              "start": 2020,
              "end": 2022
            }
          ]
        },
        "mark": {
          "type": "rect",
          "color": "#E9EAEA",
          "opacity": 0.7
        },
        "encoding": {
          "x": {
            "field": "start",
            "type": "quantitative",
            "scale": {
              "domain": [
                2018,
                2025
              ],
              "zero": false,
              "nice": false
            }
          },
          "x2": {
            "field": "end"
          }
        }
      },
      {
        "data": {
          "values": [
            {
              "v": 100
            }
          ]
        },
        "mark": {
          "type": "rule",
          "color": "#6B7280",
          "strokeDash": [
            3,
            3
          ]
        },
        "encoding": {
          "y": {
            "field": "v",
            "type": "quantitative"
          }
        }
      },
      {
        "mark": {
          "type": "line",
          "color": "#1B6F78",
          "strokeWidth": 2,
          "point": {
            "filled": true,
            "size": 25,
            "color": "#1B6F78"
          }
        },
        "encoding": {
          "x": {
            "field": "year",
            "type": "quantitative",
            "title": null,
            "scale": {
              "domain": [
                2018,
                2025
              ],
              "zero": false,
              "nice": false
            },
            "axis": {
              "format": "d",
              "values": [
                2018,
                2021,
                2025
              ],
              "grid": false
            }
          },
          "y": {
            "field": "index",
            "type": "quantitative",
            "title": null,
            "scale": {
              "domain": [
                0,
                170
              ],
              "nice": false
            },
            "axis": {
              "values": [
                0,
                50,
                100,
                150
              ],
              "grid": true
            }
          },
          "tooltip": [
            {
              "field": "sector",
              "title": "Sector"
            },
            {
              "field": "year",
              "type": "quantitative",
              "format": "d",
              "title": "Year"
            },
            {
              "field": "enrolments",
              "type": "quantitative",
              "format": ",",
              "title": "Enrolments (courses)"
            },
            {
              "field": "index",
              "type": "quantitative",
              "format": ".0f",
              "title": "Index (2018 = 100)"
            }
          ]
        }
      },
      {
        "transform": [
          {
            "filter": "datum.sector == 'Higher Education' && datum.year == 2025"
          }
        ],
        "mark": {
          "type": "text",
          "align": "right",
          "dx": -4,
          "dy": -10,
          "fontSize": 12,
          "fontWeight": 600,
          "color": "#1F2937"
        },
        "encoding": {
          "x": {
            "field": "year",
            "type": "quantitative"
          },
          "y": {
            "field": "index",
            "type": "quantitative"
          },
          "text": {
            "value": "136 (+36%)"
          }
        }
      },
      {
        "transform": [
          {
            "filter": "datum.sector == 'VET' && datum.year == 2024"
          }
        ],
        "mark": {
          "type": "text",
          "align": "right",
          "dx": -6,
          "dy": -8,
          "fontSize": 12,
          "fontWeight": 600,
          "color": "#1F2937"
        },
        "encoding": {
          "x": {
            "field": "year",
            "type": "quantitative"
          },
          "y": {
            "field": "index",
            "type": "quantitative"
          },
          "text": {
            "value": "158 peak"
          }
        }
      },
      {
        "transform": [
          {
            "filter": "datum.sector == 'ELICOS' && datum.year == 2021"
          }
        ],
        "mark": {
          "type": "text",
          "align": "left",
          "dx": 6,
          "dy": 4,
          "fontSize": 12,
          "fontWeight": 600,
          "color": "#1F2937"
        },
        "encoding": {
          "x": {
            "field": "year",
            "type": "quantitative"
          },
          "y": {
            "field": "index",
            "type": "quantitative"
          },
          "text": {
            "value": "29 (−71%)"
          }
        }
      },
      {
        "transform": [
          {
            "filter": "datum.sector == 'Non-award' && datum.year == 2021"
          }
        ],
        "mark": {
          "type": "text",
          "align": "left",
          "dx": 6,
          "dy": 4,
          "fontSize": 12,
          "fontWeight": 600,
          "color": "#1F2937"
        },
        "encoding": {
          "x": {
            "field": "year",
            "type": "quantitative"
          },
          "y": {
            "field": "index",
            "type": "quantitative"
          },
          "text": {
            "value": "25 (−75%)"
          }
        }
      }
    ]
  }
}