{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Origin-destination flow map: students travelling from the 30 largest source countries to Australia. Curved flows arrive on the side of Australia facing their origin, so they do not all pile onto one point; thin flows are drawn above thick ones (Jenny et al. 2018). Line width = students. Hover over a flow or dot to isolate one country. Use the slider or Play to change the year.",
  "width": "container",
  "height": 430,
  "params": [
    {
      "name": "year",
      "value": 2025,
      "bind": {
        "input": "range",
        "min": 2005,
        "max": 2025,
        "step": 1,
        "name": "Year "
      }
    },
    {
      "name": "grow",
      "value": 1
    }
  ],
  "projection": {
    "type": "equalEarth",
    "rotate": [
      -150,
      0
    ],
    "fit": {
      "type": "Sphere"
    }
  },
  "layer": [
    {
      "data": {
        "sphere": true
      },
      "mark": {
        "type": "geoshape",
        "fill": "#F3F5F6"
      }
    },
    {
      "data": {
        "url": "data/geo/world-110m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#E2E3E0",
        "stroke": "#FFFFFF",
        "strokeWidth": 0.4
      }
    },
    {
      "data": {
        "url": "data/geo/world-110m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "transform": [
        {
          "filter": "datum.id == '036'"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#C9CED2",
        "stroke": "#FFFFFF",
        "strokeWidth": 0.4
      }
    },
    {
      "data": {
        "url": "data/flows.csv",
        "format": {
          "parse": {
            "year": "number",
            "students": "number",
            "rank": "number",
            "lon": "number",
            "lat": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.year == year"
        },
        {
          "calculate": "datum.country == 'Malaysia' ? 'Malaysia' : 'Other countries'",
          "as": "group"
        },
        {
          "calculate": "datum.lon < -30 ? datum.lon + 360 : datum.lon",
          "as": "olon"
        },
        {
          "calculate": "datum.olon > 160 ? 'east' : (datum.olon < 60 ? 'west' : 'north')",
          "as": "coast"
        },
        {
          "calculate": "datum.coast == 'north' ? 118 + (min(max(datum.olon, 60), 145) - 60) / 85 * 28 : (datum.coast == 'east' ? 153 : 114.5)",
          "as": "dest_lon"
        },
        {
          "calculate": "datum.coast == 'north' ? -16 : (datum.coast == 'east' ? -33 + (min(max(datum.lat, -35), 40) + 35) / 75 * 12 : -32 + (min(max(datum.lat, -35), 60) + 35) / 95 * 12)",
          "as": "dest_lat"
        },
        {
          "calculate": "datum.country + ' ' + format(datum.students, '.3~s')",
          "as": "label"
        },
        {
          "calculate": "datum.lon + (datum.country == 'India' ? -4 : (datum.country == 'Bangladesh' ? 6.5 : 0))",
          "as": "label_lon"
        },
        {
          "calculate": "datum.lat + (datum.country == 'Nepal' ? 3.5 : (datum.country == 'India' ? -1.5 : 0))",
          "as": "label_lat"
        }
      ],
      "layer": [
        {
          "mark": {
            "type": "rule",
            "strokeCap": "round",
            "opacity": 1
          },
          "encoding": {
            "longitude": {
              "field": "lon_a",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat_a",
              "type": "quantitative"
            },
            "longitude2": {
              "field": "lon_b"
            },
            "latitude2": {
              "field": "lat_b"
            },
            "strokeWidth": {
              "field": "students",
              "type": "quantitative",
              "title": "Students",
              "scale": {
                "domain": [
                  0,
                  200000
                ],
                "range": [
                  0.3,
                  11
                ]
              },
              "legend": {
                "values": [
                  10000,
                  50000,
                  100000,
                  200000
                ],
                "format": "~s",
                "orient": "bottom-left",
                "direction": "horizontal"
              }
            },
            "color": {
              "field": "group",
              "type": "nominal",
              "title": null,
              "scale": {
                "domain": [
                  "Malaysia",
                  "Other countries"
                ],
                "range": [
                  "#C8102E",
                  "#7D8B99"
                ]
              },
              "legend": {
                "orient": "bottom-right",
                "direction": "horizontal"
              }
            },
            "order": {
              "field": "students",
              "type": "quantitative",
              "sort": "descending"
            },
            "tooltip": [
              {
                "field": "country",
                "title": "Country"
              },
              {
                "field": "year",
                "type": "quantitative",
                "format": "d",
                "title": "Year"
              },
              {
                "field": "students",
                "type": "quantitative",
                "format": ",",
                "title": "Students in Australia"
              },
              {
                "field": "rank",
                "type": "quantitative",
                "title": "Rank among source countries"
              }
            ],
            "opacity": {
              "condition": {
                "param": "hl",
                "empty": true,
                "value": 1
              },
              "value": 0.12
            }
          },
          "transform": [
            {
              "calculate": "datum.lon < -30 ? datum.lon + 360 : datum.lon",
              "as": "olon"
            },
            {
              "calculate": "(datum.olon + datum.dest_lon) / 2 + (datum.dest_lat - datum.lat) * 0.22",
              "as": "cx"
            },
            {
              "calculate": "(datum.lat + datum.dest_lat) / 2 - (datum.dest_lon - datum.olon) * 0.22",
              "as": "cy"
            },
            {
              "calculate": "sequence(0, 0.93, 0.035)",
              "as": "ts"
            },
            {
              "flatten": [
                "ts"
              ],
              "as": [
                "t"
              ]
            },
            {
              "filter": "datum.t < grow"
            },
            {
              "calculate": "datum.t + 0.035",
              "as": "u"
            },
            {
              "calculate": "pow(1-datum.t,2)*datum.olon + 2*(1-datum.t)*datum.t*datum.cx + pow(datum.t,2)*datum.dest_lon",
              "as": "lon_a"
            },
            {
              "calculate": "pow(1-datum.t,2)*datum.lat + 2*(1-datum.t)*datum.t*datum.cy + pow(datum.t,2)*datum.dest_lat",
              "as": "lat_a"
            },
            {
              "calculate": "pow(1-datum.u,2)*datum.olon + 2*(1-datum.u)*datum.u*datum.cx + pow(datum.u,2)*datum.dest_lon",
              "as": "lon_b"
            },
            {
              "calculate": "pow(1-datum.u,2)*datum.lat + 2*(1-datum.u)*datum.u*datum.cy + pow(datum.u,2)*datum.dest_lat",
              "as": "lat_b"
            }
          ],
          "params": [
            {
              "name": "hl",
              "select": {
                "type": "point",
                "fields": [
                  "country"
                ],
                "on": "pointerover",
                "clear": "pointerout"
              }
            }
          ]
        },
        {
          "mark": {
            "type": "circle",
            "opacity": 0.9,
            "stroke": "#FFFFFF",
            "strokeWidth": 1
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "size": {
              "value": 30
            },
            "color": {
              "field": "group",
              "type": "nominal"
            },
            "tooltip": [
              {
                "field": "country",
                "title": "Country"
              },
              {
                "field": "year",
                "type": "quantitative",
                "format": "d",
                "title": "Year"
              },
              {
                "field": "students",
                "type": "quantitative",
                "format": ",",
                "title": "Students in Australia"
              },
              {
                "field": "rank",
                "type": "quantitative",
                "title": "Rank among source countries"
              }
            ],
            "order": {
              "field": "students",
              "type": "quantitative",
              "sort": "descending"
            },
            "opacity": {
              "condition": {
                "param": "hl",
                "empty": true,
                "value": 0.95
              },
              "value": 0.15
            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum.rank <= 6 || datum.country == 'Malaysia'"
            }
          ],
          "mark": {
            "type": "text",
            "dy": -9,
            "fontSize": 12,
            "fontWeight": 600,
            "stroke": "#FFFFFF",
            "strokeWidth": 3,
            "strokeOpacity": 0.8
          },
          "encoding": {
            "longitude": {
              "field": "label_lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "label_lat",
              "type": "quantitative"
            },
            "text": {
              "field": "label"
            },
            "opacity": {
              "condition": {
                "param": "hl",
                "empty": true,
                "value": 1
              },
              "value": 0.15
            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum.rank <= 6 || datum.country == 'Malaysia'"
            }
          ],
          "mark": {
            "type": "text",
            "dy": -9,
            "fontSize": 12,
            "fontWeight": 600
          },
          "encoding": {
            "longitude": {
              "field": "label_lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "label_lat",
              "type": "quantitative"
            },
            "text": {
              "field": "label"
            },
            "color": {
              "field": "group",
              "type": "nominal"
            },
            "opacity": {
              "condition": {
                "param": "hl",
                "empty": true,
                "value": 1
              },
              "value": 0.15
            }
          }
        }
      ]
    },
    {
      "data": {
        "values": [
          {
            "lon": 134,
            "lat": -25.5,
            "label": "Australia"
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 13,
        "fontWeight": 700,
        "color": "#1F2A37"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        }
      }
    }
  ]
}