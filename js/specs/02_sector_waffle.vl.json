{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Waffle chart: out of every 100 international enrolments in December 2025, how many are in each education sector.",
  "width": 260,
  "height": 260,
  "data": {
    "url": "data/sector_waffle_2025.csv"
  },
  "transform": [
    {
      "calculate": "datum.sector + ' (' + format(datum.sector_share, '.0f') + '%)'",
      "as": "legend_label"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "#FFFFFF",
        "strokeWidth": 2,
        "cornerRadius": 2
      },
      "encoding": {
        "x": {
          "field": "col",
          "type": "ordinal",
          "axis": null
        },
        "y": {
          "field": "row",
          "type": "ordinal",
          "axis": null
        },
        "color": {
          "field": "legend_label",
          "type": "nominal",
          "title": null,
          "sort": {
            "field": "cell",
            "op": "min"
          },
          "scale": {
            "range": [
              "#1B6F78",
              "#C9862B",
              "#6C8EBF",
              "#A88BB5",
              "#B8BCC2"
            ]
          },
          "legend": {
            "orient": "right",
            "labelFontSize": 12.5,
            "symbolType": "square",
            "symbolSize": 160
          }
        },
        "tooltip": [
          {
            "field": "sector",
            "title": "Sector"
          },
          {
            "field": "sector_enrolments",
            "type": "quantitative",
            "format": ",",
            "title": "Enrolments (Dec 2025)"
          },
          {
            "field": "sector_share",
            "type": "quantitative",
            "format": ".1f",
            "title": "Share (%)"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "t": "Universities + vocational colleges = 86 of every 100"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "fontSize": 12,
        "fontWeight": 600,
        "color": "#1F2937",
        "x": 0,
        "y": {
          "expr": "height + 10"
        }
      },
      "encoding": {
        "text": {
          "field": "t"
        }
      }
    }
  ]
}