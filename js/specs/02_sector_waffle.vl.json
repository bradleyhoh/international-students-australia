{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Waffle chart: out of every 100 international enrolments in December 2025, how many are in each education sector.",
  "width": 260,
  "height": 260,
  "data": {"url": "data/sector_waffle_2025.csv"},
  "transform": [
    {"calculate": "datum.sector + ' (' + format(datum.sector_share, '.0f') + '%)'", "as": "legend_label"}
  ],
  "mark": {"type": "rect", "stroke": "#FFFFFF", "strokeWidth": 2, "cornerRadius": 2},
  "encoding": {
    "x": {"field": "col", "type": "ordinal", "axis": null},
    "y": {"field": "row", "type": "ordinal", "axis": null},
    "color": {
      "field": "legend_label", "type": "nominal", "title": null,
      "sort": {"field": "cell", "op": "min"},
      "scale": {"range": ["#2F5D8A", "#C9862B", "#5FA39B", "#8D78B6", "#9CA3AF"]},
      "legend": {"orient": "right", "labelFontSize": 12.5, "symbolType": "square", "symbolSize": 160}
    },
    "tooltip": [
      {"field": "sector", "title": "Sector"},
      {"field": "sector_enrolments", "type": "quantitative", "format": ",", "title": "Enrolments (Dec 2025)"},
      {"field": "sector_share", "type": "quantitative", "format": ".1f", "title": "Share (%)"}
    ]
  }
}
