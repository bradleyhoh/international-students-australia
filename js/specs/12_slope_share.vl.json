{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Slope chart: each country's share of all international students in Australia, 2015 vs 2025, on a linear scale. The top 6 sources in each year plus Malaysia. Where values are close, labels are nudged apart and joined to their points by thin leader lines.",
  "width": "container",
  "height": 460,
  "data": {
    "url": "data/slope_share.csv",
    "format": {
      "parse": {
        "year": "number",
        "students": "number",
        "share": "number",
        "label_y": "number"
      }
    }
  },
  "transform": [
    {
      "joinaggregate": [
        {
          "op": "argmin",
          "field": "year",
          "as": "first"
        },
        {
          "op": "argmax",
          "field": "year",
          "as": "last"
        }
      ],
      "groupby": [
        "country"
      ]
    },
    {
      "calculate": "datum.last.share / datum.first.share",
      "as": "ratio"
    },
    {
      "calculate": "datum.country == 'Malaysia' ? 'Malaysia' : (datum.ratio >= 1 ? 'Larger share in 2025' : 'Smaller share in 2025')",
      "as": "trend"
    },
    {
      "calculate": "datum.year == 2015 ? datum.country + '  ' + format(datum.share, '.1f') + '%' : format(datum.share, '.1f') + '%  ' + datum.country",
      "as": "label"
    },
    {
      "calculate": "datum.year == 2015 ? 2013.9 : 2026.1",
      "as": "label_x"
    }
  ],
  "encoding": {
    "x": {
      "field": "year",
      "type": "quantitative",
      "scale": {
        "domain": [
          2008.5,
          2031.5
        ],
        "zero": false,
        "nice": false
      },
      "axis": {
        "values": [
          2015,
          2025
        ],
        "format": "d",
        "title": null,
        "orient": "top",
        "domain": false,
        "ticks": false,
        "grid": false,
        "labelFontSize": 13,
        "labelFontWeight": 700,
        "labelPadding": 8
      }
    },
    "color": {
      "field": "trend",
      "type": "nominal",
      "title": null,
      "scale": {
        "domain": [
          "Malaysia",
          "Larger share in 2025",
          "Smaller share in 2025"
        ],
        "range": [
          "#C8102E",
          "#1B6F78",
          "#8A919C"
        ]
      },
      "legend": {
        "orient": "bottom",
        "direction": "horizontal",
        "labelLimit": 220,
        "columns": 2
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 2.2
      },
      "encoding": {
        "y": {
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              30
            ],
            "nice": false,
            "zero": true
          },
          "axis": null,
          "field": "share"
        },
        "detail": {
          "field": "country"
        },
        "strokeWidth": {
          "condition": {
            "test": "datum.country == 'Malaysia'",
            "value": 4
          },
          "value": 2.2
        }
      }
    },
    {
      "mark": {
        "type": "rule",
        "strokeWidth": 0.8,
        "opacity": 0.7
      },
      "encoding": {
        "y": {
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              30
            ],
            "nice": false,
            "zero": true
          },
          "axis": null,
          "field": "share"
        },
        "x2": {
          "field": "label_x"
        },
        "y2": {
          "field": "label_y"
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 55,
        "opacity": 1
      },
      "encoding": {
        "y": {
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              30
            ],
            "nice": false,
            "zero": true
          },
          "axis": null,
          "field": "share"
        },
        "tooltip": [
          {
            "field": "country",
            "title": "Country"
          },
          {
            "field": "year",
            "type": "quantitative",
            "format": "d",
            "title": "Year"
          },
          {
            "field": "students",
            "type": "quantitative",
            "format": ",",
            "title": "Students"
          },
          {
            "field": "share",
            "type": "quantitative",
            "format": ".1f",
            "title": "% of all international students"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year == 2015 && datum.country != 'Malaysia'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -3,
        "baseline": "middle",
        "fontSize": 12,
        "fontWeight": 400
      },
      "encoding": {
        "x": {
          "field": "label_x",
          "type": "quantitative"
        },
        "y": {
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              30
            ],
            "nice": false,
            "zero": true
          },
          "axis": null,
          "field": "label_y"
        },
        "text": {
          "field": "label"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year == 2015 && datum.country == 'Malaysia'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -3,
        "baseline": "middle",
        "fontSize": 12,
        "fontWeight": 700
      },
      "encoding": {
        "x": {
          "field": "label_x",
          "type": "quantitative"
        },
        "y": {
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              30
            ],
            "nice": false,
            "zero": true
          },
          "axis": null,
          "field": "label_y"
        },
        "text": {
          "field": "label"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year == 2025 && datum.country != 'Malaysia'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 3,
        "baseline": "middle",
        "fontSize": 12,
        "fontWeight": 400
      },
      "encoding": {
        "x": {
          "field": "label_x",
          "type": "quantitative"
        },
        "y": {
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              30
            ],
            "nice": false,
            "zero": true
          },
          "axis": null,
          "field": "label_y"
        },
        "text": {
          "field": "label"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year == 2025 && datum.country == 'Malaysia'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 3,
        "baseline": "middle",
        "fontSize": 12,
        "fontWeight": 700
      },
      "encoding": {
        "x": {
          "field": "label_x",
          "type": "quantitative"
        },
        "y": {
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              30
            ],
            "nice": false,
            "zero": true
          },
          "axis": null,
          "field": "label_y"
        },
        "text": {
          "field": "label"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    }
  }
}